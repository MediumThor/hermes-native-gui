{
  "name": "hermes-native-gui",
  "version": "0.1.0",
  "description": "A normal React Native / Expo GUI for Hermes Agent over the structured JSON-RPC gateway.",
  "private": false,
  "license": "MIT",
  "author": "Hermes Agent contributors",
  "main": "expo/AppEntry.js",
  "bin": {
    "hermes-native-gui": "bin/hermes-native-gui.js"
  },
  "files": [
    "App.tsx",
    "app.json",
    "bin/",
    "dist/",
    "server/",
    "src/",
    "README.md",
    "tsconfig.json"
  ],
  "scripts": {
    "start": "expo start --web --port 19006",
    "web": "expo start --web --port 19006",
    "bridge": "node bin/hermes-native-gui.js --bridge-only --no-open",
    "dev": "node bin/hermes-native-gui.js --dev --no-open",
    "build:web": "expo export --platform web --output-dir dist",
    "prepack": "npm run build:web",
    "serve": "node bin/hermes-native-gui.js --no-open",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "concurrently": "^9.2.1",
    "expo": "~54.0.30",
    "expo-status-bar": "~3.0.9",
    "lucide-react-native": "^0.577.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20.19.0 || >=22.12.0"
  },
  "keywords": [
    "hermes-agent",
    "react-native",
    "expo",
    "gui",
    "json-rpc"
  ]
}
